# ==============================================================================
# ReservCampus — modèle de variables d'environnement
# ------------------------------------------------------------------------------
# Copier ce fichier en `.env` puis renseigner les valeurs.
#   cp .env.example .env
# Le `.env` réel est ignoré par Git (.gitignore) : ne jamais y mettre de clé
# secrète ni le committer.
# ==============================================================================

# --- Client (exposé au navigateur, préfixe VITE_ obligatoire) ---------------
# URL de l'instance de base de données / authentification.
VITE_SUPABASE_URL=
# Clé publiable (lecture publique, sans valeur secrète).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Identifiant de l'instance.
VITE_SUPABASE_PROJECT_ID=

# --- Serveur (jamais exposé au navigateur) -----------------------------------
# Mêmes valeurs, relues côté serveur pour les fonctions et les routes API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- IA (résumé des réservations dans le tableau de bord) -------------------
# Clé serveur de la passerelle IA. Secrète : à ne jamais committer.
LOVABLE_API_KEY=
